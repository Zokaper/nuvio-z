<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- No Internet permission: this probe cannot contact Apple or anisette services. -->
    <application android:allowBackup="false" android:label="Nuvio Z USB Probe"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <receiver android:name=".UsbPermissionReceiver" android:exported="false" />
        <activity android:name=".UsbProbeActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/apple_usb_devices" />
        </activity>
    </application>
</manifest>
